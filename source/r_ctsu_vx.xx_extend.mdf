	</resourceInfo>
	<configuration>
		<property id="CTSU_CFG_PARAM_CHECKING_ENABLE" display="Parameter check" default="BSP_CFG_PARAM_CHECKING_ENABLE" type="combobox">
			<option id="CTSU_CFG_PARAM_CHECKING_ENABLE.0" display="Disable parameter checks" value="0"/>
			<option id="CTSU_CFG_PARAM_CHECKING_ENABLE.1" display="Enable parameter checks" value="1"/>
			<option id="CTSU_CFG_PARAM_CHECKING_ENABLE.BSP_CFG_PARAM_CHECKING_ENABLE" display="Use system default" value="BSP_CFG_PARAM_CHECKING_ENABLE"/>
			<description>Setting to BSP_CFG_PARAM_CHECKING_ENABLE utilizes the system default setting
Setting to 1 includes parameter checking; 0 compiles out parameter checking</description>
		</property>
		<property id="CTSU_CFG_DTC_SUPPORT_ENABLE" display="Data transfer of INTCTSUWR and INTCTSURD" default="0" type="combobox">
            <constraint display="This feature is not available on RL78G16" actionOnFail="disable">("${Device.group}" != "RL78G16")</constraint>
			<option id="CTSU_CFG_DTC_SUPPORT_ENABLE.0" display="Interrupt handler" value="0"/>
            <option id="CTSU_CFG_DTC_SUPPORT_ENABLE.1" display="DTC" value="1"/>
			<description>For standard interrupt handling, set this to 0.
To use DTC for read/write register handling, set this to 1. DTC will reduce CPU usage compared to normal interrupts when many TS are being used.</description>
		</property>
        <property id="CTSU_CFG_DTC_USE_SC" display="DTC setting " default="0" type="combobox">
            <constraint display="This feature is not available on RL78G16" actionOnFail="disable">("${Device.group}" != "RL78G16")</constraint>
			<option id="CTSU_CFG_DTC_USE_SC.0" display="Setting in r_ctsu" value="0"/>
			<option id="CTSU_CFG_DTC_USE_SC.1" display="Setting in DTC with Smart Configurator" value="1"/>
			<description>Set 1 if you want to coexist with the settings in Smart Configurator, such as when using DTC with other modules. Assign CTSUWR to DTCD22 and CTSURD to DTCD23. The transfer mode is normal mode, and the transfer data size is 16 bits. Other settings are rewritten in the CTSU driver, so no settings are required.
It is convenient to set 0 if DTC is used only by the CTSU driver. DTC settings are made in the CTSU driver and DTC transfer is performed. CTSUWR uses DTCD22 and CTSURD uses DTCD23. The start address of the DTC control data is 0x0FFD00.</description>
		</property>
		<property id="CTSU_CFG_AUTO_JUDGE_ENABLE" display="Select auto judgement" default="0" type="combobox">
            <option id="CTSU_CFG_AUTO_JUDGE_ENABLE.0" display="Disable" value="0"/>
            <option id="CTSU_CFG_AUTO_JUDGE_ENABLE.1" display="Enable" value="1"/>
            <constraint display="DTC must be enabled when auto judgement is enabled." actionOnFail="error">
            ("${CTSU_CFG_AUTO_JUDGE_ENABLE}" == "1") &amp;&amp; ("${CTSU_CFG_DTC_SUPPORT_ENABLE}" == "1")
            ||("${CTSU_CFG_AUTO_JUDGE_ENABLE}" == "0") &amp;&amp; ("${CTSU_CFG_DTC_SUPPORT_ENABLE}" == "0")
            ||("${CTSU_CFG_AUTO_JUDGE_ENABLE}" == "0") &amp;&amp; ("${CTSU_CFG_DTC_SUPPORT_ENABLE}" == "1")
            </constraint>
            <constraint display="This feature is not available on RL78/G16" actionOnFail="disable">("${Device.group}" != "RL78G16")</constraint>
            <constraint display="This feature is not available on RL78/G22" actionOnFail="disable">("${Device.group}" != "RL78G22")</constraint>
            <constraint display="This feature is not available on RL78/G23" actionOnFail="disable">("${Device.group}" != "RL78G23")</constraint>
            <constraint display="This feature is not available on RL78/L23" actionOnFail="disable">("${Device.group}" != "RL78L23")</constraint>
            <description>Select enable / disable of auto judgement code.
            -Disable:Disable use the code for auto judgement.
            -Enable:Enable use the code for auto judgement.
            It is recommended to set auto judgement for each touch interface(configuration method) with QE of Capacitve Touch.</description>
		</property>
		<property id="CTSU_CFG_CTSUWR_ADDRESS" display="Data storage address setting for CTSUWR" default="0xFF300" type="textbox">
            <constraint display="When auto judgement is enabled" actionOnFail="disable">${CTSU_CFG_AUTO_JUDGE_ENABLE} == ${CTSU_CFG_AUTO_JUDGE_ENABLE.1}</constraint>
            <constraint display="Must set the lower 8bits to 00H.">(0x00 == (${CTSU_CFG_CTSUWR_ADDRESS} &amp; 0xFF))</constraint>
			<description>Data storage address setting for CTSUWR.</description>
		</property>
		<property id="CTSU_CFG_SELF_RAW_ADDRESS" display="Variable address setting for g_ctsu_self_raw." default="0xFF400" type="textbox">
            <constraint display="When auto judgement is enabled" actionOnFail="disable">${CTSU_CFG_AUTO_JUDGE_ENABLE} == ${CTSU_CFG_AUTO_JUDGE_ENABLE.1}</constraint>
            <constraint display="Must set the lower 8bits to 00H.">(0x00 == (${CTSU_CFG_SELF_RAW_ADDRESS} &amp; 0xFF))</constraint>
			<description>Variable address setting for g_ctsu_self_raw.</description>
		</property>
		<property id="CTSU_CFG_MUTUAL_RAW_ADDRESS" display="Variable address setting for g_ctsu_mutual_raw" default="0xFF500" type="textbox">
            <constraint display="When auto judgement is enabled" actionOnFail="disable">${CTSU_CFG_AUTO_JUDGE_ENABLE} == ${CTSU_CFG_AUTO_JUDGE_ENABLE.1}</constraint>
            <constraint display="Must set the lower 8bits to 00H.">(0x00 == (${CTSU_CFG_SELF_RAW_ADDRESS} &amp; 0xFF))</constraint>
			<description>Variable address setting for g_ctsu_mutual_raw.</description>
		</property>
		<property id="CTSU_CFG_AJTHR_ADDRESS" display="Data storage address setting for CTSUAJTHR." default="0xFF600" type="textbox">
            <constraint display="When auto judgement is enabled" actionOnFail="disable">${CTSU_CFG_AUTO_JUDGE_ENABLE} == ${CTSU_CFG_AUTO_JUDGE_ENABLE.1}</constraint>
            <constraint display="Must set the lower 8bits to 00H.">(0x00 == (${CTSU_CFG_AJTHR_ADDRESS} &amp; 0xFF))</constraint>
			<description>Data storage address setting for CTSUAJTHR.</description>
		</property>
		<property id="CTSU_CFG_AJMMAR_ADDRESS" display="Data storage address setting for CTSUAJMMAR." default="0xFF700" type="textbox">
            <constraint display="When auto judgement is enabled" actionOnFail="disable">${CTSU_CFG_AUTO_JUDGE_ENABLE} == ${CTSU_CFG_AUTO_JUDGE_ENABLE.1}</constraint>
            <constraint display="Must set the lower 8bits to 00H.">(0x00 == (${CTSU_CFG_AJMMAR_ADDRESS} &amp; 0xFF))</constraint>
			<description>Data storage address setting for CTSUAJMMAR.</description>
		</property>
		<property id="CTSU_CFG_AJBLACT_ADDRESS" display="Data storage address setting for CTSUAJBLACT." default="0xFF800" type="textbox">
            <constraint display="When auto judgement is enabled" actionOnFail="disable">${CTSU_CFG_AUTO_JUDGE_ENABLE} == ${CTSU_CFG_AUTO_JUDGE_ENABLE.1}</constraint>
            <constraint display="Must set the lower 8bits to 00H.">(0x00 == (${CTSU_CFG_AJBLACT_ADDRESS} &amp; 0xFF))</constraint>
			<description>Data storage address setting for CTSUAJBLACT.</description>
		</property>
		<property id="CTSU_CFG_AJBLAR_ADDRESS" display="Data storage address setting for CTSUAJBLAR." default="0xFF900" type="textbox">
            <constraint display="When auto judgement is enabled" actionOnFail="disable">${CTSU_CFG_AUTO_JUDGE_ENABLE} == ${CTSU_CFG_AUTO_JUDGE_ENABLE.1}</constraint>
            <constraint display="Must set the lower 8bits to 00H.">(0x00 == (${CTSU_CFG_AJBLAR_ADDRESS} &amp; 0xFF))</constraint>
			<description>Data storage address setting for CTSUAJBLAR.</description>
		</property>
		<property id="CTSU_CFG_AJRR_ADDRESS" display="Data storage address setting for CTSUAJRR." default="0xFFA00" type="textbox">
            <constraint display="When auto judgement is enabled" actionOnFail="disable">${CTSU_CFG_AUTO_JUDGE_ENABLE} == ${CTSU_CFG_AUTO_JUDGE_ENABLE.1}</constraint>
            <constraint display="Must set the lower 8bits to 00H.">(0x00 == (${CTSU_CFG_AJRR_ADDRESS} &amp; 0xFF))</constraint>
			<description>Data storage address setting for CTSUAJRR.</description>
		</property>
		<property id="CTSU_CFG_MCACT1_ADDRESS" display="Data storage address setting for CTSUMCACT1." default="0xFFB00" type="textbox">
            <constraint display="When auto judgement is enabled" actionOnFail="disable">${CTSU_CFG_AUTO_JUDGE_ENABLE} == ${CTSU_CFG_AUTO_JUDGE_ENABLE.1}</constraint>
            <constraint display="Must set the lower 8bits to 00H.">(0x00 == (${CTSU_CFG_MCACT1_ADDRESS} &amp; 0xFF))</constraint>
			<description>Data storage address setting for CTSUMCACT1.</description>
		</property>
		<property id="CTSU_CFG_MCACT2_ADDRESS" display="Data storage address setting for CTSUMCACT2." default="0xFFC00" type="textbox">
            <constraint display="When auto judgement is enabled" actionOnFail="disable">${CTSU_CFG_AUTO_JUDGE_ENABLE} == ${CTSU_CFG_AUTO_JUDGE_ENABLE.1}</constraint>
            <constraint display="Must set the lower 8bits to 00H.">(0x00 == (${CTSU_CFG_MCACT2_ADDRESS} &amp; 0xFF))</constraint>
			<description>Data storage address setting for CTSUMCACT2.</description>
		</property>
		<property id="CTSU_CFG_SMS_SUPPORT_ENABLE" display="Auto-judgment function in Snooze mode using SMS" default="0" type="combobox">
            <constraint display="This feature is not available on RL78/G16" actionOnFail="disable">("${Device.group}" != "RL78G16")</constraint>
            <constraint display="This feature is not available on RL78/F25" actionOnFail="disable">("${Device.group}" != "RL78F25")</constraint>
            <constraint display="This feature is not available on RL78/F22" actionOnFail="disable">("${Device.group}" != "RL78F22")</constraint>
			<option id="CTSU_CFG_SMS_SUPPORT_ENABLE.0" display="Disable" value="0"/>
			<option id="CTSU_CFG_SMS_SUPPORT_ENABLE.1" display="Enable" value="1"/>
			<description>Enables the code for the auto-judgment feature in Snooze mode using SMS.</description>
		</property>
		<property id="CTSU_CFG_SMS_TRANSFER_ADDRESS" display="Data storage address setting for CTSURD" default="0xFF500" type="textbox">
            <constraint display="When SMS is enabled" actionOnFail="disable">${CTSU_CFG_SMS_SUPPORT_ENABLE} == ${CTSU_CFG_SMS_SUPPORT_ENABLE.1}</constraint>
            <constraint display="Must set the lower 8bits to 00H.">(0x00 == (${CTSU_CFG_SMS_TRANSFER_ADDRESS} &amp; 0xFF))</constraint>
			<description>Data storage address setting for CTSURD. This data use 544 bytes from this address.</description>
		</property>
		<property id="CTSU_CFG_SMS_CTSUWR_ADDRESS" display="Data storage address setting for CTSUWR" default="0xFF800" type="textbox">
            <constraint display="When SMS is enabled" actionOnFail="disable">${CTSU_CFG_SMS_SUPPORT_ENABLE} == ${CTSU_CFG_SMS_SUPPORT_ENABLE.1}</constraint>
            <constraint display="Must set the lower 8bits to 00H.">(0x00 == (${CTSU_CFG_SMS_CTSUWR_ADDRESS} &amp; 0xFF))</constraint>
			<description>Data storage address setting for CTSUWR. This data use (4 * element_num * multi_freq_num) bytes from this address.</description>
		</property>
		<property id="CTSU_CFG_INTCTSUWR_PRIORITY_LEVEL" display="Interrupt level for INTCTSUWR" default="2" type="combobox">
			<option id="CTSU_CFG_INTCTSUWR_PRIORITY_LEVEL.0" display="Level 0(highest)" value="0"/>
			<option id="CTSU_CFG_INTCTSUWR_PRIORITY_LEVEL.1" display="Level 1" value="1"/>
			<option id="CTSU_CFG_INTCTSUWR_PRIORITY_LEVEL.2" display="Level 2" value="2"/>
			<option id="CTSU_CFG_INTCTSUWR_PRIORITY_LEVEL.3" display="Level 3(Lowest)" value="3"/>
			<description>This defines the interrupt priority level for INTCTSUWR</description>
		</property>
		<property id="CTSU_CFG_INTCTSURD_PRIORITY_LEVEL" display="Interrupt level for INTCTSURD" default="2" type="combobox">
			<option id="CTSU_CFG_INTCTSURD_PRIORITY_LEVEL.0" display="Level 0(highest)" value="0"/>
			<option id="CTSU_CFG_INTCTSURD_PRIORITY_LEVEL.1" display="Level 1" value="1"/>
			<option id="CTSU_CFG_INTCTSURD_PRIORITY_LEVEL.2" display="Level 2" value="2"/>
			<option id="CTSU_CFG_INTCTSURD_PRIORITY_LEVEL.3" display="Level 3(Lowest)" value="3"/>
			<description>This defines the interrupt priority level for INTCTSURD</description>
		</property>
		<property id="CTSU_CFG_INTCTSUFN_PRIORITY_LEVEL" display="Interrupt level for INTCTSUFN" default="2" type="combobox">
			<option id="CTSU_CFG_INTCTSUFN_PRIORITY_LEVEL.0" display="Level 0(highest)" value="0"/>
			<option id="CTSU_CFG_INTCTSUFN_PRIORITY_LEVEL.1" display="Level 1" value="1"/>
			<option id="CTSU_CFG_INTCTSUFN_PRIORITY_LEVEL.2" display="Level 2" value="2"/>
			<option id="CTSU_CFG_INTCTSUFN_PRIORITY_LEVEL.3" display="Level 3(Lowest)" value="3"/>
			<description>This defines the interrupt priority level for INTCTSUFN</description>
		</property>
        <property id="CTSU_CFG_SMS_EXTRIGGER_PORT" display="Output port number for external trigger" default="P14" type="combobox">
            <option id="CTSU_CFG_SMS_EXTRIGGER_PORT.0" display="PORT0" value="P0"/>
            <option id="CTSU_CFG_SMS_EXTRIGGER_PORT.1" display="PORT1" value="P1"/>
            <option id="CTSU_CFG_SMS_EXTRIGGER_PORT.2" display="PORT2" value="P2"/>
            <option id="CTSU_CFG_SMS_EXTRIGGER_PORT.3" display="PORT3" value="P3"/>
            <option id="CTSU_CFG_SMS_EXTRIGGER_PORT.4" display="PORT4" value="P4"/>
            <option id="CTSU_CFG_SMS_EXTRIGGER_PORT.5" display="PORT5" value="P5"/>
            <option id="CTSU_CFG_SMS_EXTRIGGER_PORT.6" display="PORT6" value="P6"/>
            <option id="CTSU_CFG_SMS_EXTRIGGER_PORT.7" display="PORT7" value="P7"/>
            <option id="CTSU_CFG_SMS_EXTRIGGER_PORT.12" display="PORT12" value="P12"/>
            <option id="CTSU_CFG_SMS_EXTRIGGER_PORT.13" display="PORT13" value="P13"/>
            <option id="CTSU_CFG_SMS_EXTRIGGER_PORT.14" display="PORT14" value="P14"/>
            <constraint display="When SMS is enabled" actionOnFail="disable">${CTSU_CFG_SMS_SUPPORT_ENABLE} == ${CTSU_CFG_SMS_SUPPORT_ENABLE.1}</constraint>
            <constraint display="This feature is used only in RL78/G22" actionOnFail="disable">("${Device.group}" == "RL78G22")</constraint>
            <description>Output port of external trigger that invokes SMS</description>
        </property>
        <property id="CTSU_CFG_SMS_EXTRIGGER_BIT" display="Bit number for exrernal trigger output" default="1" type="combobox">
            <option id="CTSU_CFG_SMS_EXTRIGGER_BIT.0" display="BIT0" value="1"/>
            <option id="CTSU_CFG_SMS_EXTRIGGER_BIT.1" display="BIT1" value="2"/>
            <option id="CTSU_CFG_SMS_EXTRIGGER_BIT.2" display="BIT2" value="4"/>
            <option id="CTSU_CFG_SMS_EXTRIGGER_BIT.3" display="BIT3" value="8"/>
            <option id="CTSU_CFG_SMS_EXTRIGGER_BIT.4" display="BIT4" value="16"/>
            <option id="CTSU_CFG_SMS_EXTRIGGER_BIT.5" display="BIT5" value="32"/>
            <option id="CTSU_CFG_SMS_EXTRIGGER_BIT.6" display="BIT6" value="64"/>
            <option id="CTSU_CFG_SMS_EXTRIGGER_BIT.7" display="BIT7" value="128"/>
            <constraint display="When SMS is enabled" actionOnFail="disable">${CTSU_CFG_SMS_SUPPORT_ENABLE} == ${CTSU_CFG_SMS_SUPPORT_ENABLE.1}</constraint>
            <constraint display="This feature is used only in RL78/G22" actionOnFail="disable">("${Device.group}" == "RL78G22")</constraint>
            <description>Bit to which the external trigger is connected</description>
        </property>
        <property id="CTSU_CFG_SMS_ELC_INTP" display="Interrupt port number for external trigger" default="1" type="combobox">
            <option id="CTSU_CFG_SMS_ELC_INTP.0" display="INTP0" value="0"/>
            <option id="CTSU_CFG_SMS_ELC_INTP.1" display="INTP1" value="1"/>
            <option id="CTSU_CFG_SMS_ELC_INTP.2" display="INTP2" value="2"/>
            <option id="CTSU_CFG_SMS_ELC_INTP.3" display="INTP3" value="3"/>
            <option id="CTSU_CFG_SMS_ELC_INTP.4" display="INTP4" value="4"/>
            <option id="CTSU_CFG_SMS_ELC_INTP.5" display="INTP5" value="5"/>
            <option id="CTSU_CFG_SMS_ELC_INTP.6" display="INTP6" value="6"/>
            <constraint display="When SMS is enabled" actionOnFail="disable">${CTSU_CFG_SMS_SUPPORT_ENABLE} == ${CTSU_CFG_SMS_SUPPORT_ENABLE.1}</constraint>
            <constraint display="This feature is used only in RL78/G22" actionOnFail="disable">("${Device.group}" == "RL78G22")</constraint>
            <description>Select the interrupt request port number. The interrupt port must be enabled in INTC component.
Available only when using SMS on RL78/G22.</description>
                <!-- RL78/G22 SMS setting only.</description> -->
        </property>
	</configuration>
</module>

