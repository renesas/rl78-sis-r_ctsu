				<pinConfiguration config="AUTO"/>
			</pin>
			<pin name="TS17">
				<pinConfiguration config="AUTO"/>
			</pin>
			<pin name="TS18">
				<pinConfiguration config="AUTO"/>
			</pin>
			<pin name="TS19">
				<pinConfiguration config="AUTO"/>
			</pin>
			<pin name="TS20">
				<pinConfiguration config="AUTO"/>
			</pin>
			<pin name="TS21">
				<pinConfiguration config="AUTO"/>
			</pin>
			<pin name="TS22">
				<pinConfiguration config="AUTO"/>
			</pin>
